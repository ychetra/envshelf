# Non-secret runtime settings only.
ENVSHELF_PORT=8787
ENVSHELF_DATA_DIR=/var/lib/envshelf

# Docker paths. Keep the key mount read-only; do not put private values here.
ENVSHELF_PROJECTS_HOST_PATH=./projects
# Root written into catalog.json paths. For Docker, set this to the same
# absolute host path as ENVSHELF_PROJECTS_HOST_PATH.
# For Docker CLI registrations using /workspace paths, leave this as /workspace.
# For a host-authored catalog, replace it with the absolute host project root.
ENVSHELF_CATALOG_ROOT=/workspace
ENVSHELF_KEYS_HOST_PATH=./keys
ENVSHELF_PROJECT_ROOT=/workspace
ENVSHELF_RECIPIENT_FILE=/keys/recipient.txt
ENVSHELF_IDENTITY_FILE=/keys/identity.txt
